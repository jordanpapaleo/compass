# Compass gateway — provider API keys (copy to gateway/.env, which is gitignored)
# At least one key is required for live completions; all three for full routing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama (keyless) — set to enable local routing
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Optional
# COMPASS_PORT=4000
# COMPASS_DATA_DIR=~/.compass
