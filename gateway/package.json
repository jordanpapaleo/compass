{
  "name": "compass-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compass gateway sidecar — OpenAI-compatible endpoint with intent-based routing across raw provider SDKs",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/genai": "^1.16.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "openai": "^6.9.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "~5.8.3",
    "vitest": "^4.1.0"
  }
}
